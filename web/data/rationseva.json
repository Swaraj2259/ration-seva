  "rules": [
    {
      "version": "v1.3",
      "effectiveFrom": "2026-10-18",
      "publishedAt": "2026-10-03T17:13:35.979Z",
      "publishedBy": "State Food & Civil Supplies Dept",
      "governmentOrderRef": "GO-MS-12/2027/FCS",
      "summary": "Raising priority household (PHH) annual income limit from ₹1,00,000 to ₹1,20,000 as per state cabinet revision.",
      "rules": [
        {
          "type": "NEW_CARD",
          "incomeLimit": 100000,
          "minMembers": 1,
          "maxMembers": 15,
          "requiredDocs": [
            "Proof of Residence",
            "Aadhaar Cards of all members",
            "Income Certificate from Tahsildar"
          ]
        },
        {
          "type": "ADD_MEMBER",
          "incomeLimit": 100000,
          "minMembers": 1,
          "maxMembers": 15,
          "requiredDocs": [
            "Birth Certificate / Marriage Certificate",
            "Aadhaar Card of New Member"
          ]
        },
        {
          "type": "REMOVE_MEMBER",
          "incomeLimit": 100000,
          "minMembers": 1,
          "maxMembers": 15,
          "requiredDocs": [
            "Death Certificate / Marriage Certificate / Migration NOC"
          ]
        },
        {
          "type": "ADDRESS_CHANGE",
          "incomeLimit": 100000,
          "minMembers": 1,
          "maxMembers": 15,
          "requiredDocs": [
            "New Electricity Bill / Water Bill / Registered Lease Deed"
          ]
        },
        {
          "type": "DUPLICATE",
          "incomeLimit": 100000,
          "minMembers": 1,
          "maxMembers": 15,
          "requiredDocs": [
            "Police Lost-Report / Self-Declaration Affidavit / Damaged Card"
          ]
        }
      ]
    },
